#define BLYNK_TEMPLATE_ID "TMPLxxxx"
#define BLYNK_TEMPLATE_NAME "Flame"
#define BLYNK_AUTH_TOKEN "YourToken"

#include <ESP8266WiFi.h>
#include <BlynkSimpleEsp8266.h>

char ssid[] = "NamaWiFi";
char pass[] = "PasswordWiFi";

#define FLAME D5
#define LED D2

BlynkTimer timer;

void sendSensor()
{
  int flameValue = digitalRead(FLAME);

  Blynk.virtualWrite(V0, flameValue);

  if(flameValue == 0)
  {
    digitalWrite(LED, HIGH);
    Blynk.logEvent("fire_alert", "Api terdeteksi!");
  }
  else
  {
    digitalWrite(LED, LOW);
  }
}

void setup()
{
  pinMode(FLAME, INPUT);
  pinMode(LED, OUTPUT);

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);

  timer.setInterval(1000L, sendSensor);
}

void loop()
{
  Blynk.run();
  timer.run();
}
